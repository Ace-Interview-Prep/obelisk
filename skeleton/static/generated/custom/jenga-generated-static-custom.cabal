cabal-version:      3.4
name:               jenga-generated-static-custom
version:            0.1.0.0
license:            NONE
build-type:         Custom
data-dir:           data

custom-setup
  setup-depends:
    base >= 4.7 && < 5,
    Cabal >= 3.0 && < 4,
    jenga-setup

library
    build-depends:      base
                        --
                      , ghc-prim
                      , jenga-setup
                      , text

    hs-source-dirs:     src
    exposed-modules:    Jenga.Generated.Static

    default-language:   Haskell2010

    if (arch(javascript) || arch(wasm32))
      buildable: False
