#!/usr/bin/env bash
# ob-run: Development server with sub-second reloads via ghcid.
# Does an initial full build (including WASM), then uses ghcid to keep GHC
# loaded in memory for instant incremental recompilation on source changes.
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: ob-run [-- CABAL_ARGS...]"
  echo ""
  echo "  Builds the backend (including WASM frontend) once, then starts ghcid"
  echo "  for sub-second reloads. GHC stays loaded in memory — only changed"
  echo "  modules are recompiled on save."
  echo "  Disables -O2 and specialisation flags for faster rebuilds."
  echo "  Extra arguments after -- are passed through to cabal repl."
  echo "  To rebuild WASM after frontend changes, Ctrl+C and re-run ob-run."
  exit 0
fi

DEV_GHC_OPTIONS=(
  --ghc-options=-O0
  --ghc-options=-fno-specialise
  --ghc-options=-fno-expose-all-unfoldings
  --ghc-options=-fno-specialise-aggressively
  --ghc-options=-fno-late-specialise
  --ghc-options=-fno-cross-module-specialise
)

# Step 1: Full build to ensure WASM assets and symlinks exist.
echo "==> Building backend (including WASM frontend)..."
OBELISK_CROSS_CABAL_ARGS="-O0 ${DEV_GHC_OPTIONS[*]}" \
  cabal build backend -O0 "${DEV_GHC_OPTIONS[@]}" "$@"

# Step 2: ghcid for sub-second reloads.
# Multi-repl loads all library sources into GHCi so ghcid watches them all.
# --poll: ghcid 0.8.9 can't parse GHC 9.14 multi-repl's per-unit :show paths
#   output, producing garbled watch paths and infinite loops. --poll bypasses
#   inotify entirely, polling for changes every second instead.
# --run: chains :add (to bring DevMain into the session after multi-repl
#   modules are loaded) and DevMain.devMain (to start the server).
# -f -cross: skips frontend-wasm Setup.hs hooks in the REPL.
echo "==> Starting ghcid (sub-second reloads on save)..."
echo "    Ctrl+C to stop. Re-run ob-run to rebuild WASM after frontend changes."
exec ghcid \
  --command="cabal repl --enable-multi-repl lib:backend lib:common lib:frontend -O0 -f -cross ${DEV_GHC_OPTIONS[*]} $*" \
  --warnings \
  --poll \
  --run=':cmd return ":add *backend/src/DevMain.hs\nDevMain.devMain"' \
  --restart=backend/backend.cabal \
  --restart=common/common.cabal \
  --restart=frontend/frontend.cabal \
  --restart=landing-page/landing-page.cabal \
  --restart=cabal.project
