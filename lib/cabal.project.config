allow-newer:
    hnix:*
  , hnix-store-core:algebraic-graphs

constraints:
    hnix-store-core < 0.7
  , hnix-store-remote < 0.7
  , happy < 2.2

if arch(wasm32)
  shared: True
  allow-newer:
      *:*
    , *:time
  constraints:
    , time >= 1.15

if impl(ghc == 9.14.*)
  allow-newer:
      *:base
    , *:template-haskell
    , *:ghc-experimental
    , *:ghc-internal
    , *:time
    , *:containers
    , patch:containers
    , parser-regex:ghc-bignum
    , monad-control:transformers-compat
    -- rhyolite ecosystem bounds relaxation for GHC 9.14
    , *:text
    , *:vector
    , *:bytestring
    , *:aeson
    , *:mtl
    , *:transformers
    , *:deepseq
    , *:QuickCheck
    , *:quickcheck-instances
    , *:pretty-simple
    , *:ghc-prim
    , *:lens
    , *:attoparsec
    , *:scientific
    , *:hashable
    , *:unordered-containers
    , *:exceptions
    , *:postgresql-simple
    , *:uuid
    , *:dlist
    , *:string-conv
    , *:splitmix
    , *:criterion
    , *:resource-pool
    , *:postgresql-libpq
    , *:snap-core
    , *:snap-server
    , *:io-streams
    , *:http-streams
    , *:HsOpenSSL
    , *:dependent-map
    , *:dependent-sum
    , *:ref-tf
    , *:monad-control
    , *:transformers-base
    , *:constraints-extras
    , *:some
    , *:semialign
    , *:these
    , *:witherable
    , *:commutative-semigroups
    , *:patch
    , *:reflex
    , *:stm
    , *:th-abstraction
    , *:th-lift
    , *:th-expand-syns
    , *:th-orphans
    , *:filepath
    , *:directory
    , *:digestive-functors
  constraints:
      base < 4.23
    , template-haskell < 2.25
    , ghc-experimental < 9.1500
    , ghc-internal < 9.1500
    , happy < 2.2
    , th-abstraction >= 0.7

if impl(ghc < 9.14)
  -- https://github.com/haskellari/splitmix/pull/73
  -- https://github.com/haskellari/splitmix/pull/75
  source-repository-package
    type: git
    location: https://github.com/alexfmpe/splitmix
    tag: bd53859c0f41d12f16c3f44fee52f5e9aae26243
    --sha256: 1r3b75axljbnfjcjbpjxc8dqqcrbsz9mhr4fwngqd1is70d9msp0

  -- https://github.com/haskell-cryptography/HsOpenSSL/issues/93#issuecomment-2311816896
  package HsOpenSSL
    ghc-options: -optc=-Wno-incompatible-pointer-types"
