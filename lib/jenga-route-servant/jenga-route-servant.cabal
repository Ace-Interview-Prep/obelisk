cabal-version:      3.0
name:               jenga-route-servant
version:            0.1.0.0
synopsis:           Servant-based routing for Jenga, replacing obelisk-route
license:            BSD-3-Clause
build-type:         Simple

library
  exposed-modules:
    Jenga.Route
    Jenga.Route.Frontend
    Jenga.Route.TH
    Jenga.Frontend

  -- Backend modules only on native targets (not WASM/JS)
  if !(arch(wasm32) || arch(javascript))
    exposed-modules:
      Jenga.Route.Backend
      Jenga.Backend

  build-depends:
    , base              >=4.12 && <5
    , bytestring
    , containers
    , data-default
    , dependent-sum
    , effectful-core
    , ghcjs-dom
    , jsaddle
    , lens
    , reflex
    , reflex-dom-core
    , reflex-effectful
    , text

  -- Servant + backend deps (not on WASM/JS — servant needs generics-sop
  -- which uses TH that fails on GHC WASM backend)
  if !(arch(wasm32) || arch(javascript))
    build-depends:
      , http-types
      , servant
      , servant-server
      , snap-core
      , snap-server

  hs-source-dirs:   src
  default-language:  Haskell2010

  default-extensions:
    ConstraintKinds
    DataKinds
    FlexibleContexts
    FlexibleInstances
    GADTs
    KindSignatures
    MultiParamTypeClasses
    OverloadedStrings
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
